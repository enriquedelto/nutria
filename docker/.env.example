# Copia a docker/.env y rellena. NUNCA subas el .env al repo.
NUTRIA_PORT=8130
# Carpeta de datos (postgres, uploads, backups, modelos de whisper). Relativa a docker/.
NUTRIA_DATA=./data
POSTGRES_PASSWORD=cambia-esto

# Solo este correo puede crear la primera cuenta (admin) sin invitación. Recomendado si se publica antes de registrarse.
ADMIN_EMAIL=

# URL pública exacta (las passkeys quedan atadas a este dominio).
BETTER_AUTH_URL=https://dieta.tu-dominio.example
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Cifrado de credenciales de tiendas, secretos de openGym y fotos de progreso. openssl rand -base64 32
APP_ENCRYPTION_KEY=

# IA: subscription (token de `claude setup-token`) | api (ANTHROPIC_API_KEY) | mock (pruebas)
AI_BACKEND=subscription
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Opcional: modelo más rápido para la traducción de alimentos y la lectura de etiquetas (ahorra límite de la suscripción)
AI_MODEL_FAST=
# Peticiones de IA por persona y día (admins sin límite) y gasto mensual con API key
AI_DAILY_LIMIT=60
AI_MONTHLY_USD=10

# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Open Food Facts
OFF_USER_AGENT=Nutria/0.1 (admin@example.com)
OFF_COUNTRIES=en:spain

# Opcionales
WHISPER_MODEL=small
OPENGYM_URL=https://gym.tu-dominio.example
# Solo si openGym va en el mismo servidor detrás de Caddy: su nombre, para que el contenedor llegue al host.
OPENGYM_HOST=gym.tu-dominio.example
MERCADONA_WAREHOUSE=mad1
FLARESOLVERR_URL=
