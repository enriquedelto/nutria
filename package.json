{
  "name": "nutria",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nutria/web dev",
    "build": "pnpm --filter @nutria/web build",
    "worker": "pnpm --filter @nutria/worker start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @nutria/web lint",
    "db:generate": "pnpm --filter @nutria/db generate",
    "db:migrate": "pnpm --filter @nutria/db migrate",
    "db:seed": "pnpm --filter @nutria/db seed"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
