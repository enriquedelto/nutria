{
  "name": "nutria",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nutria/web dev",
    "build": "pnpm --filter @nutria/web build",
    "worker": "pnpm --filter @nutria/worker start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @nutria/web lint",
    "db:generate": "pnpm --filter @nutria/db generate",
    "db:migrate": "pnpm --filter @nutria/db migrate",
    "db:seed": "pnpm --filter @nutria/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
